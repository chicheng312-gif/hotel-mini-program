/* Vant 公共工具类：须放在小程序目录内，不可 @import node_modules（微信 WXSS 限制） */
@import "./styles/vant-common.wxss";

page {
  --primary: #2563eb;
  --primary-dark: #1d4ed8;
  --primary-soft: #eff6ff;
  --accent: #2563eb;
  --accent-soft: #dbeafe;
  --price-color: #e11d48;
  --text: #1c1f2e;
  --text-secondary: #6b7288;
  --text-tertiary: #9aa3b5;
  --border: #e8ebf2;
  --bg: #f4f6fb;
  --card: #ffffff;
  --surface-muted: #eef1f8;
  --radius: 20rpx;
  --radius-lg: 28rpx;
  --radius-pill: 999rpx;
  --shadow-sm: 0 4rpx 16rpx rgba(28, 31, 46, 0.06);
  --shadow: 0 12rpx 40rpx rgba(28, 31, 46, 0.08);
  --gradient-primary: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  --gradient-hero: linear-gradient(135deg, #1e3a5f 0%, #334155 52%, #2563eb 100%);
  --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  --duration-fast: 0.2s;
  --tab-bar-h: calc(112rpx + env(safe-area-inset-bottom));
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", Helvetica,
    "PingFang SC", "Microsoft YaHei", sans-serif;
  background: var(--bg);
  color: var(--text);
  font-size: 28rpx;
  box-sizing: border-box;
}

.safe-bottom {
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.ios-card {
  background: var(--card);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow);
}

.hover-press {
  transform: scale(0.985);
  opacity: 0.92;
}

.btn-primary {
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  font-weight: 600;
  border: none;
  transition: opacity var(--duration-fast) var(--ease-out),
    transform var(--duration-fast) var(--ease-out);
}

.btn-primary:active {
  opacity: 0.88;
  transform: scale(0.98);
}

.btn-primary[disabled] {
  opacity: 0.45;
}

.price {
  color: var(--price-color);
  font-weight: 700;
}
