.page {
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f2f2f7;
  box-sizing: border-box;
}

.ios-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
}

.bar {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  margin-bottom: 16rpx;
}

.ico {
  margin-right: 12rpx;
  opacity: 0.4;
  font-size: 28rpx;
}

.input {
  flex: 1;
  height: 64rpx;
  font-size: 30rpx;
  color: #1c1c1e;
}

.go {
  margin-left: 16rpx;
  font-size: 28rpx;
  color: #007aff;
  font-weight: 600;
}

.chips {
  display: flex;
  flex-direction: row;
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 4rpx 0;
}

.chip {
  display: inline-flex;
  padding: 12rpx 28rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #fff;
  font-size: 24rpx;
  color: #636366;
}

.chip.on {
  background: #007aff;
  color: #fff;
  font-weight: 600;
}

.filter {
  padding: 20rpx 24rpx 24rpx;
  margin-bottom: 20rpx;
}

.f-label {
  font-size: 24rpx;
  color: #8e8e93;
  display: block;
  margin-bottom: 12rpx;
}

.f-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.f-input {
  flex: 1;
  height: 64rpx;
  background: #f2f2f7;
  border-radius: 12rpx;
  padding: 0 16rpx;
  font-size: 26rpx;
}

.f-dash {
  color: #c7c7cc;
}

.f-btn {
  margin: 0;
  background: #007aff;
  color: #fff;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.hist-block {
  margin-bottom: 24rpx;
}

.hist-head {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
  padding: 0 4rpx;
}

.hist-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c1c1e;
}

.hist-clear {
  font-size: 26rpx;
  color: #007aff;
}

.hist-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.hist-chip {
  padding: 12rpx 24rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #3a3a3c;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  margin: 8rpx 0 16rpx;
  color: #1c1c1e;
}

.feed {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.card {
  overflow: hidden;
}

.cover {
  width: 100%;
  height: 300rpx;
  background: #e5e5ea;
  display: block;
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c7c7cc;
}

.body {
  padding: 14rpx 16rpx 18rpx;
}

.name {
  font-size: 26rpx;
  color: #1c1c1e;
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 72rpx;
}

.price {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #ff3b30;
}

.sales {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #8e8e93;
}

.empty {
  text-align: center;
  color: #8e8e93;
  padding: 80rpx 0;
  font-size: 28rpx;
}

.footer {
  text-align: center;
  padding: 24rpx;
  color: #c7c7cc;
  font-size: 24rpx;
}
