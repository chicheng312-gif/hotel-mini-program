.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
  background: var(--bg);
  box-sizing: border-box;
}

.head {
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text);
}

.head-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.feed {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.card {
  overflow: hidden;
  transition: transform var(--duration-fast) var(--ease-out);
}

.card:active {
  transform: scale(0.985);
}

.cover {
  width: 100%;
  height: 300rpx;
  background: var(--surface-muted);
}

.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
}

.body {
  padding: 14rpx 16rpx 18rpx;
}

.name {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 72rpx;
}

.price {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--price-color);
}

.sales {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.empty {
  text-align: center;
  color: var(--text-tertiary);
  padding: 100rpx 0;
}

.footer {
  text-align: center;
  padding: 24rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
}
