.page {
  padding: 24rpx 24rpx 80rpx;
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.t {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.label {
  font-size: 26rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 12rpx;
}

.stars {
  display: flex;
  gap: 12rpx;
}

.star {
  font-size: 48rpx;
  color: #e2e8f0;
}

.star.on {
  color: #fbbf24;
}

.area {
  width: 100%;
  min-height: 200rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.submit {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
}

.empty {
  text-align: center;
  padding: 120rpx;
  color: var(--text-secondary);
}
