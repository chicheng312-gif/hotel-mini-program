.page {
  min-height: 100vh;
  padding-bottom: 120rpx;
  background: #f2f2f7;
  box-sizing: border-box;
}

.gallery {
  height: 750rpx;
  background: #000;
}

.g-img,
.g-video {
  width: 100%;
  height: 100%;
  display: block;
}

.gallery-empty {
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8e8e93;
  background: #e5e5ea;
}

.sheet {
  margin: -32rpx 16rpx 24rpx;
  padding: 28rpx 24rpx 8rpx;
  position: relative;
  z-index: 2;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.p-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #1c1c1e;
  line-height: 1.35;
}

.price-row {
  margin-top: 16rpx;
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: #ff3b30;
}

.orig {
  font-size: 26rpx;
  color: #8e8e93;
  text-decoration: line-through;
}

.meta-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.meta {
  font-size: 24rpx;
  color: #8e8e93;
}

.meta.dot {
  opacity: 0.5;
}

.stock-out {
  color: #ff3b30;
}

.rate-row {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.rate-text {
  font-size: 24rpx;
  color: #636366;
  margin-left: 8rpx;
}

.rate-count {
  font-size: 22rpx;
  color: #8e8e93;
}

.rate-muted {
  font-size: 24rpx;
  color: #c7c7cc;
}

.cell-group {
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.block {
  margin: 0 16rpx 28rpx;
  padding: 0 8rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1c1c1e;
  margin-bottom: 16rpx;
  display: block;
}

.rich-wrap {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.review {
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
}

.review-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.nick {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1c1e;
}

.review-body {
  font-size: 28rpx;
  color: #3a3a3c;
  line-height: 1.5;
}

.review-time {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #c7c7cc;
}

.more-btn {
  margin: 16rpx auto 0 !important;
  display: flex !important;
  justify-content: center;
}

.spacer {
  height: 120rpx;
}

.state {
  padding: 120rpx;
  text-align: center;
  color: #8e8e93;
}

/* 规格弹层 */
.spec-panel {
  padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
}

.spec-h {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  display: block;
}

.spec-label {
  font-size: 26rpx;
  color: #636366;
  margin: 16rpx 0 12rpx;
  display: block;
}

.spec-values {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.spec-chip {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f2f2f7;
  font-size: 26rpx;
  color: #1c1c1e;
}

.spec-chip.on {
  background: rgba(0, 122, 255, 0.12);
  color: #007aff;
  font-weight: 600;
}
