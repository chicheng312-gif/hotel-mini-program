<view class="page">
  <view wx:if="{{loading && !list.length}}" class="state">加载中…</view>
  <view wx:elif="{{!list.length}}" class="state">暂无积分流水</view>
  <view wx:else class="list">
    <view class="item" wx:for="{{list}}" wx:key="_id">
      <view class="left">
        <text class="t">{{item.remark || item.type}}</text>
        <text class="s">{{item.timeStr}}</text>
      </view>
      <text class="delta {{item.changeValue >= 0 ? 'plus' : 'minus'}}">
        {{item.changeValue >= 0 ? '+' : ''}}{{item.changeValue}}
      </text>
    </view>
  </view>
  <view class="foot" wx:if="{{list.length}}">上拉加载更多</view>
</view>
