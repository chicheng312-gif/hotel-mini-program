.page {
  display: flex;
  height: 100vh;
  background: var(--bg);
}

.side {
  width: 200rpx;
  background: rgba(255, 255, 255, 0.96);
  border-right: 1rpx solid var(--border);
  padding-bottom: var(--tab-bar-h);
}

.side-item {
  padding: 28rpx 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  text-align: center;
  border-left: 6rpx solid transparent;
  transition: color var(--duration-fast) var(--ease-out),
    background var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out);
}

.side-item.on {
  color: var(--primary);
  font-weight: 700;
  background: var(--primary-soft);
  border-left-color: var(--primary);
}

.main {
  flex: 1;
  padding: 20rpx 20rpx var(--tab-bar-h);
  box-sizing: border-box;
  -webkit-overflow-scrolling: touch;
}

.row {
  display: flex;
  padding: 20rpx;
  margin-bottom: 20rpx;
  transition: transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.row:active {
  transform: scale(0.995);
}

.thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: var(--radius);
  background: var(--surface-muted);
  flex-shrink: 0;
}

.thumb-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.info {
  flex: 1;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text);
}

.sub {
  font-size: 22rpx;
  color: var(--text-secondary);
  margin-top: 8rpx;
}

.row-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 12rpx;
}

.mini-add {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: var(--gradient-primary);
  color: #fff;
  font-size: 36rpx;
  font-weight: 300;
  border: none;
  transition: transform var(--duration-fast) var(--ease-out),
    opacity var(--duration-fast) var(--ease-out);
}

.mini-add:active {
  transform: scale(0.92);
  opacity: 0.88;
}

.state {
  text-align: center;
  color: var(--text-secondary);
  padding: 80rpx 0;
}
