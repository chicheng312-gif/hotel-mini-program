.page {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.card {
  background: var(--card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
  padding: 32rpx;
}

.t {
  font-size: 34rpx;
  font-weight: 800;
  display: block;
}

.p {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.55;
  display: block;
}
