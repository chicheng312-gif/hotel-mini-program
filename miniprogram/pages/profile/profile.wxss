.page {
  min-height: 100vh;
  padding: 24rpx 24rpx var(--tab-bar-h);
  box-sizing: border-box;
  background: var(--bg);
  color: var(--text);
}

.page.theme-dark {
  --primary: #3b82f6;
  --primary-dark: #2563eb;
  --primary-soft: #1e293b;
  --accent: #6ea8ff;
  --accent-soft: #1e3a5f;
  --price-color: #fb7185;
  --text: #e8eaef;
  --text-secondary: #9aa3b5;
  --text-tertiary: #6b7288;
  --border: #2a3142;
  --bg: #0f1117;
  --card: #1a1d26;
  --surface-muted: #252a36;
  --shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.35);
  --gradient-hero: linear-gradient(135deg, #0f172a 0%, #1e293b 55%, #1d4ed8 100%);
}

.hero {
  padding: 32rpx 28rpx 24rpx;
  background: var(--gradient-hero);
  color: #fff;
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow);
}

.hero-top {
  display: flex;
  align-items: flex-start;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.15);
  border: 3rpx solid rgba(255, 255, 255, 0.25);
  transition: transform var(--duration-fast) var(--ease-out);
}

.avatar-wrap:active {
  transform: scale(0.96);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  line-height: 120rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
}

.hero-meta {
  flex: 1;
  margin-left: 24rpx;
}

.nick {
  font-size: 34rpx;
  font-weight: 800;
  display: block;
}

.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.stat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pill {
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.15);
}

.phone-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  gap: 16rpx;
}

.phone-txt {
  font-size: 24rpx;
  opacity: 0.95;
  flex: 1;
}

.bind-phone {
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  color: var(--primary-dark);
  background: #fff;
  border-radius: var(--radius-pill);
  border: none;
}

.sign-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.12);
}

.sign-btn {
  margin: 0;
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-pill);
  border: none;
  font-weight: 600;
  transition: opacity var(--duration-fast) var(--ease-out);
}

.sign-btn.disabled {
  opacity: 0.5;
}

.sign-tip {
  font-size: 22rpx;
  opacity: 0.85;
  max-width: 360rpx;
  text-align: right;
}

.block {
  margin-top: 20rpx;
  padding: 24rpx 24rpx 28rpx;
  transition: transform var(--duration-fast) var(--ease-out);
}

.block:active {
  transform: scale(0.995);
}

.block-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 800;
}

.block-more {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.block-body {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
}

.block-foot {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.order-row {
  display: flex;
  justify-content: space-between;
  padding-top: 8rpx;
}

.order-cell {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  transition: transform var(--duration-fast) var(--ease-out);
}

.order-cell:active {
  transform: scale(0.94);
}

.order-ico {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--primary-soft);
  color: var(--primary);
  text-align: center;
  line-height: 64rpx;
  font-weight: 800;
  font-size: 28rpx;
}

.order-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.badge {
  position: absolute;
  top: -6rpx;
  right: 8rpx;
  min-width: 28rpx;
  padding: 0 6rpx;
  height: 28rpx;
  line-height: 28rpx;
  text-align: center;
  font-size: 18rpx;
  color: #fff;
  background: var(--gradient-primary);
  border-radius: var(--radius-pill);
}

.mall-preview {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.mall-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.mall-cover {
  width: 100%;
  height: 120rpx;
  border-radius: var(--radius);
  background: var(--surface-muted);
}

.mall-name {
  font-size: 24rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mall-pts {
  font-size: 22rpx;
  color: var(--primary);
  font-weight: 700;
}

.empty-inline {
  font-size: 24rpx;
  color: var(--text-secondary);
  padding: 12rpx 0;
}

.coupon-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.invite-row {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.invite-code {
  font-size: 28rpx;
  font-weight: 700;
}

.invite-stat {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.grid-item {
  width: 33.33%;
  padding: 20rpx 0;
  box-sizing: border-box;
  text-align: center;
  transition: opacity var(--duration-fast) var(--ease-out);
}

.grid-item:active {
  opacity: 0.65;
}

.grid-t {
  font-size: 26rpx;
  font-weight: 600;
}

.fav-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.menu {
  padding: 0 8rpx;
}

.menu-cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 16rpx;
  border-bottom: 1rpx solid var(--border);
  font-size: 28rpx;
  transition: background var(--duration-fast) var(--ease-out);
}

.menu-cell:active {
  background: var(--primary-soft);
}

.menu-cell:last-child {
  border-bottom: none;
}

.arrow {
  color: var(--text-tertiary);
  font-size: 32rpx;
}

.logout {
  margin: 32rpx 0 0;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: var(--radius-lg);
  background: transparent;
  color: var(--primary);
  border: 1rpx solid var(--border);
  font-size: 28rpx;
  transition: background var(--duration-fast) var(--ease-out);
}

.logout:active {
  background: var(--primary-soft);
}

.skeleton-wrap {
  padding: 12rpx 0;
}

.sk-line {
  height: 160rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(
    90deg,
    var(--border) 25%,
    rgba(150, 150, 150, 0.15) 37%,
    var(--border) 63%
  );
  background-size: 400% 100%;
  animation: sk 1.2s ease infinite;
  margin-bottom: 20rpx;
}

.sk-a {
  height: 220rpx;
}
.sk-b {
  height: 120rpx;
}
.sk-c {
  height: 140rpx;
}
.sk-d {
  height: 88rpx;
}

.sk-grid {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.sk-pill {
  flex: 1;
  height: 100rpx;
  border-radius: 16rpx;
  background: var(--border);
}

@keyframes sk {
  0% {
    background-position: 100% 0;
  }
  100% {
    background-position: 0 0;
  }
}
