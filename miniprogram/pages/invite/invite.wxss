.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.state {
  padding: 48rpx 0;
  text-align: center;
  color: var(--text-secondary);
}

.code-card {
  padding: 24rpx;
}

.label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}

.code {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 900;
  letter-spacing: 2rpx;
  display: block;
}

.hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  display: block;
}

.t {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
}

.ipt {
  margin-top: 14rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  font-size: 28rpx;
}

.btn {
  margin-top: 16rpx;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  font-size: 26rpx;
}

.strong {
  font-weight: 800;
  color: var(--primary);
}

.cell {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.arrow {
  color: #cbd5e1;
}

.sec {
  margin: 20rpx 4rpx 10rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.mini {
  padding: 18rpx 22rpx;
  margin-bottom: 12rpx;
}

.m {
  font-size: 26rpx;
  font-weight: 600;
  display: block;
  word-break: break-all;
}

.s {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  display: block;
}
