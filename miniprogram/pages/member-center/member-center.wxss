.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.state {
  padding: 80rpx 0;
  text-align: center;
  color: var(--text-secondary);
}

.hero {
  padding: 28rpx;
}

.h-name {
  font-size: 36rpx;
  font-weight: 800;
  display: block;
}

.h-sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: var(--text-secondary);
  display: block;
}

.h-next {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--primary);
  display: block;
  line-height: 1.5;
}

.sec-title {
  margin: 24rpx 4rpx 12rpx;
  font-size: 28rpx;
  font-weight: 800;
}

.rcard {
  padding: 22rpx;
  margin-bottom: 16rpx;
}

.r-level {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
}

.r-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}
