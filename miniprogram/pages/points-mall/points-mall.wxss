.page {
  padding: 24rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--bg);
}

.card {
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.t {
  font-size: 30rpx;
  font-weight: 800;
  display: block;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 26rpx;
}

.p {
  color: var(--primary);
  font-weight: 700;
}

.btn {
  margin-top: 18rpx;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sub {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.state {
  padding: 32rpx 0;
  text-align: center;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.list {
  margin-top: 12rpx;
}

.item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--border);
}

.item:last-child {
  border-bottom: none;
}

.cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.meta {
  flex: 1;
}

.name {
  font-size: 28rpx;
  font-weight: 700;
  display: block;
}

.pts {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
}
