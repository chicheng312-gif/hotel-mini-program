<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page">
  <view class="toolbar card">
    <scroll-view class="tabs" scroll-x="true" enable-flex="true">
      <view
        class="tab {{activeTab === item.key ? 'on' : ''}}"
        wx:for="{{tabs}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTabTap"
      >
        {{item.label}}
      </view>
    </scroll-view>
    <input
      class="search"
      placeholder="搜索订单号"
      confirm-type="search"
      value="{{keyword}}"
      bindinput="onSearchInput"
    />
  </view>

  <view wx:if="{{loading}}" class="state">加载中…</view>
  <view wx:elif="{{loadError}}" class="state err">{{loadError}}</view>
  <view wx:elif="{{!list.length}}" class="state empty-state">
    <text class="empty-title">暂无订单</text>
    <text class="hint">
      若刚完成「模拟支付」，请点顶部「全部」或清空搜索框；订单会按时间倒序显示。仍没有时请确认已上传数据库权限（orders 可读 openId/openid）。
    </text>
  </view>
  <view
    wx:for="{{list}}"
    wx:key="_id"
    class="card order"
    data-id="{{item._id}}"
    bindtap="openDetail"
  >
    <view class="head">
      <text class="no">订单 {{item._id}}</text>
      <text class="st {{item.status}}">{{statusText[item.status]}}</text>
    </view>
    <view class="line" wx:for="{{item.lines}}" wx:for-index="lix" wx:key="lix" wx:for-item="row">
      <text class="t">{{row.title}} x{{row.count}}</text>
      <text class="p">¥{{fmt.price(row.subtotalFen)}}</text>
    </view>
    <view class="foot">
      <text>实付 ¥{{fmt.price(item.payFen)}}</text>
      <text class="time">{{item.createdAtStr}}</text>
    </view>
  </view>
</view>
