.page {
  min-height: 100vh;
  padding-bottom: calc(var(--tab-bar-h) + 24rpx);
  background: var(--bg);
  box-sizing: border-box;
}

.ios-safe {
  padding-top: 8rpx;
}

.search-wrap {
  padding: 12rpx 24rpx 20rpx;
}

.search-ico {
  font-size: 28rpx;
  margin-right: 12rpx;
  opacity: 0.45;
}

.search-placeholder {
  font-size: 28rpx;
  color: var(--text-tertiary);
}

.search-pill {
  height: 72rpx;
  border-radius: var(--radius-pill);
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  box-shadow: var(--shadow-sm);
  transition: transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.swiper-card {
  margin: 0 24rpx 24rpx;
}

.hero-swiper {
  height: 320rpx;
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.hero-slide {
  position: relative;
  width: 100%;
  height: 100%;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-cap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, transparent, rgba(15, 23, 42, 0.55));
}

.hero-title {
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.section {
  padding: 0 24rpx;
  margin-bottom: 28rpx;
}

.section-last {
  margin-bottom: 48rpx;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text);
  letter-spacing: 0.5rpx;
}

.section-sub {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.cat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(2, auto);
  gap: 16rpx;
}

.cat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 8rpx 16rpx;
  transition: transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.cat-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 22rpx;
  background: var(--surface-muted);
  margin-bottom: 12rpx;
}

.cat-name {
  font-size: 22rpx;
  color: var(--text);
  text-align: center;
  line-height: 1.25;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feed {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.feed-card {
  display: flex;
  flex-direction: column;
  transition: transform var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.feed-cover {
  width: 100%;
  height: 340rpx;
  background: var(--surface-muted);
  display: block;
}

.feed-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--text-tertiary);
  font-size: 28rpx;
}

.feed-body {
  padding: 16rpx 16rpx 20rpx;
}

.feed-name {
  font-size: 26rpx;
  color: var(--text);
  line-height: 1.35;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  min-height: 72rpx;
}

.feed-meta {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
}

.feed-price {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--price-color);
}

.feed-sales {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.empty-hint {
  padding: 48rpx;
  text-align: center;
  color: var(--text-tertiary);
  font-size: 26rpx;
}

.load-more {
  text-align: center;
  padding: 28rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--text-tertiary);
}
