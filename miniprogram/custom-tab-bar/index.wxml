<view class="tab-bar safe-bottom">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-bar-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <text class="tab-bar-text">{{item.text}}</text>
    <view wx:if="{{index === 2 && badge > 0}}" class="badge">{{badge > 99 ? '99+' : badge}}</view>
  </view>
</view>
